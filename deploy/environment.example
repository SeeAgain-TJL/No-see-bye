# Copy to /opt/no-see-bye/config.env. No export keyword.
DATABASE_URL=file:/opt/no-see-bye/data/app.db
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/opt/no-see-bye/data/uploads
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
USER_QUOTA_MB=2048
ALLOW_REGISTRATION=true
# Replace with your real EIP; no trailing slash.
APP_ORIGIN=http://YOUR_EIP:3000
COOKIE_SECURE=false
