[Unit]
Description=Remove unattached No See Bye media older than 24 hours
After=no-see-bye.service

[Service]
Type=oneshot
User=no-see-bye
Group=no-see-bye
WorkingDirectory=/opt/no-see-bye/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/no-see-bye/environment
ExecStartPre=/opt/no-see-bye/current/runtime/node /opt/no-see-bye/current/scripts/check-runtime.mjs
ExecStart=/opt/no-see-bye/current/runtime/node /opt/no-see-bye/current/scripts/cleanup-assets.mjs
UMask=0077
StateDirectory=no-see-bye
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/no-see-bye
TimeoutStartSec=300
