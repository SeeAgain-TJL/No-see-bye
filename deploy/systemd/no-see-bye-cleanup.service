[Unit]
Description=Remove unattached No See Bye media older than 24 hours
After=no-see-bye.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/no-see-bye
Environment=NODE_ENV=production
EnvironmentFile=/opt/no-see-bye/config.env
ExecStart=/opt/no-see-bye/runtime/node /opt/no-see-bye/scripts/cleanup-assets.mjs
UMask=0077
TimeoutStartSec=300
