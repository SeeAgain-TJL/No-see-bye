# SQLite paths resolve from prisma/.
DATABASE_URL="file:../data/app.db"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./data/uploads"
# 0 means no per-user total quota; individual upload size limits still apply.
USER_QUOTA_MB="0"
ALLOW_REGISTRATION="true"
# For ECS set this to the exact public origin, without a trailing slash.
# APP_ORIGIN="https://your-domain.example"
COOKIE_SECURE="false"
# Optional GitHub OAuth App.
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GITHUB_REDIRECT_URI="https://your-domain.example/api/auth/github"
# Optional Alibaba Cloud SMS (mainland China): approved template uses ${code}.
# SMS_ACCESS_KEY_ID=""
# SMS_ACCESS_KEY_SECRET=""
# SMS_SIGN_NAME=""
# SMS_TEMPLATE_CODE=""
