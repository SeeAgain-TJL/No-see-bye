# SQLite paths resolve from prisma/.
DATABASE_URL="file:../data/app.db"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./data/uploads"
# 0 means no per-user total quota; individual upload size limits still apply.
USER_QUOTA_MB="0"
ALLOW_REGISTRATION="true"
# For ECS set this to the exact public origin, without a trailing slash.
# APP_ORIGIN="https://your-domain.example"
COOKIE_SECURE="false"
# Password changes use the current password by default. Enable the email gate only after SMTP is configured.
PASSWORD_EMAIL_VERIFICATION="false"
# SMTP_HOST="smtp.163.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="sender@example.com"
# SMTP_PASSWORD="" # SMTP authorization code, not the mailbox login password.
# SMTP_FROM="sender@example.com"
# Create the first admin explicitly with scripts/bootstrap-admin.mjs; never commit real credentials.
# ADMIN_USERNAME="admin"
# ADMIN_EMAIL="owner@example.com"
# ADMIN_BACKUP_EMAIL="backup@example.com"
# ADMIN_PASSWORD_HASH="" # bcrypt cost 12; read only on first creation, never resets an existing account.
# Optional GitHub OAuth App.
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GITHUB_REDIRECT_URI="https://your-domain.example/api/auth/github"
