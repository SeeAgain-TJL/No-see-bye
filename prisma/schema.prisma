generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  email String @unique
  username String @unique
  passwordHash String
  displayName String @default("")
  sessionVersion Int @default(0)
  avatarKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entries Entry[]
  assets Asset[]
  oauthAccounts OAuthAccount[]
}
// Preserve the original table and records.
model Entry {
  id String @id @default(cuid())
  userId String
  title String @default("")
  content String?
  media String @default("[]")
  tags String @default("[]")
  location String @default("")
  mood String @default("")
  visibility String @default("private")
  pinned Boolean @default(false)
  happenedAt DateTime @default(now())
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments EntryAsset[]
  @@index([userId, deletedAt, happenedAt])
  @@index([visibility, deletedAt, happenedAt])
}
model Asset {
  id String @id @default(cuid())
  ownerId String
  driver String
  key String @unique
  filename String @default("")
  mime String
  sizeBytes Int
  width Int?
  height Int?
  durationMs Int?
  capturedAt DateTime?
  thumbnailKey String?
  coverKey String?
  status String @default("pending")
  createdAt DateTime @default(now())
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  attachment EntryAsset?
  @@index([ownerId, status])
  @@index([createdAt])
}
model EntryAsset {
  entryId String
  assetId String @unique
  position Int
  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  @@id([entryId, assetId])
}

model OAuthAccount {
  id String @id @default(cuid())
  provider String
  providerAccountId String
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}
