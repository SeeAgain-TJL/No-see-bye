generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  email String @unique
  username String @unique
  phone String? @unique
  hasLocalPassword Boolean @default(true)
  passwordHash String
  displayName String @default("")
  sessionVersion Int @default(0)
  role String @default("user")
  emailVerifiedAt DateTime?
  backupEmail String?
  backupEmailVerifiedAt DateTime?
  lastLoginAt DateTime?
  lastSeenAt DateTime?
  loginCount Int @default(0)
  avatarKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entries Entry[]
  assets Asset[]
  oauthAccounts OAuthAccount[]
  passwordChallenge PasswordChallenge?
  entryReactions EntryReaction[]
  entryComments EntryComment[]
}
// Preserve the original table and records.
model Entry {
  id String @id @default(cuid())
  userId String
  title String @default("")
  content String?
  media String @default("[]")
  tags String @default("[]")
  location String @default("")
  mood String @default("")
  visibility String @default("private")
  pinned Boolean @default(false)
  happenedAt DateTime @default(now())
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments EntryAsset[]
  reactions EntryReaction[]
  comments EntryComment[]
  @@index([userId, deletedAt, happenedAt])
  @@index([visibility, deletedAt, happenedAt])
}
model EntryReaction {
  entryId String
  userId String
  kind String
  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([entryId, userId, kind])
  @@index([userId, kind])
  @@index([entryId, kind])
}
model EntryComment {
  id String @id @default(cuid())
  entryId String
  userId String
  content String
  createdAt DateTime @default(now())
  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([entryId, createdAt, id])
  @@index([userId, createdAt])
}
model Asset {
  id String @id @default(cuid())
  ownerId String
  driver String
  key String @unique
  filename String @default("")
  mime String
  sizeBytes Int
  width Int?
  height Int?
  durationMs Int?
  capturedAt DateTime?
  thumbnailKey String?
  coverKey String?
  status String @default("pending")
  createdAt DateTime @default(now())
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  attachment EntryAsset?
  @@index([ownerId, status])
  @@index([createdAt])
}
model EntryAsset {
  entryId String
  assetId String @unique
  position Int
  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  @@id([entryId, assetId])
}

model OAuthAccount {
  id String @id @default(cuid())
  provider String
  providerAccountId String
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model RegistrationChallenge {
  id String @id
  bindingHash String
  answerHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  attempts Int @default(0)
  @@index([expiresAt])
}

model PasswordChallenge {
  id String @id
  userId String @unique
  email String
  sessionVersion Int
  bindingHash String
  codeHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  attempts Int @default(0)
  usedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

// These rows must survive a user's deletion to preserve cleanup work and its audit.
model MediaDeletion {
  key String @id
  driver String
  ownerId String
  createdAt DateTime @default(now())
  @@index([ownerId, createdAt])
  @@index([driver, createdAt])
}

model AdminUserAction {
  id String @id @default(cuid())
  action String
  operatorId String
  targetId String
  removedEntries Int
  removedAssets Int
  createdAt DateTime @default(now())
}
