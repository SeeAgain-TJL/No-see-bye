# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
dev.db
dev.db-journal
.prisma/

# agent skills (generated, not project-specific)
.agents/
.claude/
.cursor/
.devin/

# local uploads
/data/

# SQLite data and WAL sidecars (never commit user data)
*.db
*.db-*
*.sqlite
*.sqlite-*

# Local deployment bundles (contain a runtime, never user data)
/dist/
